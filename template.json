{
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "strategy": "ipv4_only",
    "servers": [
      {
        "tag": "dns_proxy",
        "type": "tls",
        "server": "8.8.8.8",
        "domain_resolver": "dns_resolver"
      },
      {
        "tag": "dns_direct",
        "type": "h3",
        "server": "dns.alidns.com",
        "domain_resolver": "dns_resolver"
      },
      {
        "tag": "dns_fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15"
      },
      {
        "tag": "dns_resolver",
        "type": "udp",
        "server": "223.5.5.5"
      }
    ],
    "rules": [
      {
        "rule_set": [
          "geosite-category-ads-all"
        ],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "query_type": [
          "A"
        ],
        "server": "dns_fakeip",
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "action": "route"
      },
      {
        "server": "dns_proxy",
        "rule_set": [
          "geosite-geolocation-!cn"
        ],
        "action": "route"
      }
    ],
    "final": "dns_direct"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 2080
    },
    {
      "type": "tun",
      "tag": "tun-in",
      "auto_route": true,
      "strict_route": true,
      "stack": "mixed",
      "address": [
        "172.19.0.1/30"
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "block",
      "tag": "REJECT"
    },
    {
      "type": "urltest",
      "tag": "♻️ 自动选择",
      "outbounds": [],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "outbounds": [
        "♻️ 自动选择",
        "DIRECT"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "inbound": "tun-in",
        "action": "sniff"
      },
      {
        "clash_mode": "Global",
        "outbound": "🚀 节点选择",
        "action": "route"
      },
      {
        "clash_mode": "Direct",
        "outbound": "DIRECT",
        "action": "route"
      },
      {
        "ip_is_private": true,
        "outbound": "DIRECT",
        "action": "route"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "outbound": "REJECT",
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "DIRECT",
        "action": "route"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "🚀 节点选择",
        "action": "route"
      }
    ],
    "final": "🚀 节点选择",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns_resolver",
    "default_http_client": "rule-set-http",
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs"
      },
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/category-ads-all.srs"
      },
      {
        "tag": "geosite-geolocation-!cn",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "dashboard"
    }
  },
  "http_clients": [
    {
      "tag": "rule-set-http",
      "detour": "🚀 节点选择"
    }
  ]
}
