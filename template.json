{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "local",
        "prefer_go": true
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5",
        "detour": "DIRECT"
      },
      {
        "tag": "tx",
        "type": "https",
        "server": "1.12.12.21",
        "tls": {
          "enabled": true,
          "server_name": "doh.pub"
        },
        "detour": "DIRECT"
      },
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "fakeip",
        "type": "fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18"
      }
    ],
    "rules": [
      {
        "query_type": [
          "HTTPS",
          "SVCB"
        ],
        "action": "reject"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject"
      },
      {
        "clash_mode": "Direct",
        "server": "local"
      },
      {
        "clash_mode": "Global",
        "server": "fakeip"
      },
      {
        "domain": [
          "time.apple.com"
        ],
        "domain_suffix": [
          "pool.ntp.org",
          "push.apple.com"
        ],
        "server": "local"
      },
      {
        "rule_set": [
          "geosite-cn"
        ],
        "server": "local"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "server": "google"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip",
        "rewrite_ttl": 1
      }
    ],
    "final": "local",
    "strategy": "prefer_ipv4",
    "cache_capacity": 8192,
    "optimistic": {
      "enabled": true
    }
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "strict_route": false,
      "stack": "mixed",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 2080
        }
      }
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "tag": "🚀 节点选择",
      "type": "selector",
      "outbounds": [
        "♻️ 自动选择",
        "🌐 IPv6 节点",
        "🚀 手动切换",
        "DIRECT"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "🌐 IPv6 节点",
      "type": "selector",
      "outbounds": [
        "DIRECT"
      ]
    },
    {
      "tag": "🚀 手动切换",
      "type": "selector",
      "outbounds": [
        "DIRECT"
      ]
    },
    {
      "tag": "♻️ 自动选择",
      "type": "urltest",
      "outbounds": [
        "DIRECT"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "10m",
      "idle_timeout": "30m",
      "tolerance": 50,
      "interrupt_exist_connections": true
    },
    {
      "tag": "DIRECT",
      "type": "direct",
      "domain_resolver": "ali"
    },
    {
      "tag": "REJECT",
      "type": "block"
    }
  ],
  "http_clients": [
    {
      "tag": "直连下载",
      "detour": "DIRECT"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "hijack-dns",
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ]
      },
      {
        "domain_suffix": [
          "push.apple.com"
        ],
        "outbound": "DIRECT"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": "push.apple.com"
          }
        ],
        "invert": true,
        "action": "sniff",
        "sniffer": [
          "http",
          "tls",
          "stun",
          "quic",
          "dns"
        ],
        "timeout": "200ms"
      },
      {
        "ip_is_private": true,
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "100.64.0.0/10",
          "224.0.0.0/4",
          "255.255.255.255/32"
        ],
        "outbound": "DIRECT"
      },
      {
        "action": "reject",
        "no_drop": true,
        "port": [
          135,
          137,
          138,
          139,
          445
        ]
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "protocol": [
              "stun",
              "quic"
            ]
          }
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "network": "icmp",
        "action": "resolve"
      },
      {
        "network": "icmp",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "Direct",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "Global",
        "outbound": "🚀 节点选择"
      },
      {
        "rule_set": "geosite-category-ads-all",
        "action": "reject",
        "no_drop": true
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "🚀 节点选择"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "DIRECT"
      }
    ],
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/cn.srs",
        "update_interval": "24h"
      },
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs",
        "update_interval": "24h"
      },
      {
        "tag": "geosite-geolocation-!cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/geolocation-!cn.srs",
        "update_interval": "24h"
      }
    ],
    "final": "🚀 节点选择",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "ali"
    },
    "default_http_client": "直连下载"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "dashboard"
    }
  }
}
